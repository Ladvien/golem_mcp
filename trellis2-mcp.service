[Unit]
Description=TRELLIS2 MCP Server - 3D Asset Generation
After=network.target

[Service]
Type=simple
User=ladvien
WorkingDirectory=/home/ladvien/trellis2_mcp
Environment=PATH=/home/ladvien/trellis/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=TRELLIS_REPO=/home/ladvien/trellis/repo
Environment=TRELLIS_MODEL=/home/ladvien/trellis/models/TRELLIS-image-large
Environment=TRELLIS_OUTPUT_DIR=/home/ladvien/trellis/output
Environment=SPCONV_ALGO=native
Environment=ATTN_BACKEND=xformers
# SkinTokens/TokenRig runs as a subprocess in its own Python 3.11 venv.
Environment=SKINTOKENS_REPO=/home/ladvien/skintokens/repo
Environment=SKINTOKENS_PYTHON=/home/ladvien/skintokens/.venv/bin/python
ExecStart=/home/ladvien/trellis/.venv/bin/python -m trellis2_mcp
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
