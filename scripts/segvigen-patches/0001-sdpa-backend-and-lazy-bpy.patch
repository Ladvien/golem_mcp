diff --git a/trellis2/modules/sparse/attention/full_attn.py b/trellis2/modules/sparse/attention/full_attn.py
index 4eb74d2..041c59c 100644
--- a/trellis2/modules/sparse/attention/full_attn.py
+++ b/trellis2/modules/sparse/attention/full_attn.py
@@ -211,6 +211,26 @@ def sparse_scaled_dot_product_attention(*args, **kwargs):
             max_q_seqlen = max(q_seqlen)
             max_kv_seqlen = max(kv_seqlen)
         out = flash_attn_3.flash_attn_varlen_func(q, k, v, cu_seqlens_q, cu_seqlens_kv, max_q_seqlen, max_kv_seqlen)
+    elif config.ATTN == 'sdpa':
+        from torch.nn.functional import scaled_dot_product_attention as sdpa
+        if num_all_args == 1:
+            q, k, v = qkv.unbind(dim=1)
+        elif num_all_args == 2:
+            k, v = kv.unbind(dim=1)
+        # The varlen packing is itself the block-diagonal mask, so slice each
+        # sequence out and attend within it. Handing sdpa an explicit mask would
+        # force its math backend and materialize a [T_Q, T_KV] score matrix;
+        # unmasked, it picks its own flash kernel and matches flash_attn's memory.
+        outs = []
+        q_start = kv_start = 0
+        for q_len, kv_len in zip(q_seqlen, kv_seqlen):
+            qi = q[q_start:q_start + q_len].permute(1, 0, 2).unsqueeze(0)      # [1, H, Lq, Ci]
+            ki = k[kv_start:kv_start + kv_len].permute(1, 0, 2).unsqueeze(0)   # [1, H, Lkv, Ci]
+            vi = v[kv_start:kv_start + kv_len].permute(1, 0, 2).unsqueeze(0)   # [1, H, Lkv, Co]
+            outs.append(sdpa(qi, ki, vi)[0].permute(1, 0, 2))                  # [Lq, H, Co]
+            q_start += q_len
+            kv_start += kv_len
+        out = torch.cat(outs, dim=0)    # [T_Q, H, Co]
     else:
         raise ValueError(f"Unknown attention module: {config.ATTN}")
     
