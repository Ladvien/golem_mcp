diff --git a/src/attention.py b/src/attention.py
new file mode 100644
index 0000000..7b268e8
--- /dev/null
+++ b/src/attention.py
@@ -0,0 +1,51 @@
+"""The one attention implementation, on every host and every device.
+
+WHY THIS REPLACES flash_attn RATHER THAN FALLING BACK TO IT
+-----------------------------------------------------------
+Upstream guards every attention site with `try: import flash_attn_interface /
+except: <something else>`. Traced on this fleet, that try ALWAYS fails, on both
+machines:
+
+  * `flash_attn_interface` is FlashAttention *3*'s top-level module.
+  * big has FlashAttention *2* (2.8.3), which installs as `flash_attn.*`.
+
+So `attention_processor.py` and `miche_transformer_blocks.py` have been running
+their PyTorch SDPA branches on big all along - the flash paths are dead code that
+merely looked live. Only `skin_vae_model.py:47` genuinely reached FA2, and
+`tokenrig.py` imported it without ever calling it.
+
+That left one real call site standing between this model and any non-CUDA device,
+so it is now SDPA too, and the branch is gone rather than demoted to a fallback.
+This is not a downgrade: `F.scaled_dot_product_attention` dispatches to its own
+fused flash kernel on CUDA, so big keeps flash attention - it just reaches it
+through PyTorch instead of a separately compiled wheel.
+
+CONVENTION
+----------
+flash_attn_func takes and returns (B, L, H, D) and hands back a
+(output, softmax_lse) pair. SDPA takes (B, H, L, D) and returns a bare tensor, so
+this transposes either side and pads the return to a pair. The lse is None because
+no call site in this repo reads it.
+"""
+
+import torch
+import torch.nn.functional as F
+
+
+def flash_attn_func(q, k, v):
+    """Attention over (B, L, H, D) tensors. Returns (out, None) to match FA3."""
+    # (B, L, H, D) -> (B, H, L, D)
+    q = q.transpose(1, 2)
+    k = k.transpose(1, 2)
+    v = v.transpose(1, 2)
+
+    # Grouped-query attention: fewer KV heads than query heads. SDPA has an
+    # enable_gqa flag, but expanding here keeps one code path across torch
+    # versions and costs nothing at these sequence lengths.
+    if q.shape[1] != k.shape[1]:
+        repeat = q.shape[1] // k.shape[1]
+        k = k.repeat_interleave(repeat, dim=1)
+        v = v.repeat_interleave(repeat, dim=1)
+
+    out = F.scaled_dot_product_attention(q, k, v)
+    return out.transpose(1, 2), None  # back to (B, L, H, D)
diff --git a/src/device.py b/src/device.py
new file mode 100644
index 0000000..1adf39b
--- /dev/null
+++ b/src/device.py
@@ -0,0 +1,78 @@
+"""The one place that decides which accelerator TokenRig runs on.
+
+    SKINTOKENS_DEVICE=cuda   on big  (RTX, 24 GB VRAM)
+    SKINTOKENS_DEVICE=mps    on bmb  (M4 Pro, 48 GB unified)
+
+WHY AN ENV VAR RATHER THAN AUTO-DETECTION
+-----------------------------------------
+Auto-detection is a branch, and a branch that silently picks CPU when the
+accelerator it wanted is missing is exactly the "magic result that takes hours to
+trace" this project forbids. A rig that quietly ran on CPU would not fail - it
+would take forty minutes instead of thirty seconds and look like a hung job.
+
+So the device is declared, not guessed, and an unavailable one is a hard error.
+Both hosts run byte-identical code; only the variable differs.
+
+WHY THIS EXISTS AT ALL
+----------------------
+This box OOM-kills TokenRig. Not for want of VRAM - the GPU has 20 GB free and the
+weights total 1.6 GB - but because system RAM here is backed by ZRAM, a compressed
+block device carved out of the same 32 GB, so `free` reports 25 GB available while
+processes die around 12.7 GB. bmb has 48 GB of real unified memory.
+
+SkinTokens turned out to be portable: no CUDA-compiled extensions anywhere in its
+dependency tree (no spconv, flash-attn, xformers, nvdiffrast, triton), just
+PyTorch, transformers, bpy and trimesh. The entire CUDA surface was two lines -
+this module and the two call sites that import it.
+"""
+
+import os
+
+import torch
+
+_ENV = "SKINTOKENS_DEVICE"
+
+
+def resolve_device() -> torch.device:
+    """The declared device, or a loud failure. Never a quiet downgrade."""
+    name = os.environ.get(_ENV)
+    if not name:
+        raise RuntimeError(
+            f"{_ENV} is not set. Declare the accelerator explicitly - "
+            f"'cuda' on big, 'mps' on bmb, 'cpu' only if you mean it. "
+            f"This is not auto-detected on purpose: a rig that silently fell back "
+            f"to CPU would look like a hung job rather than a failed one."
+        )
+    name = name.strip().lower()
+
+    if name == "cuda" and not torch.cuda.is_available():
+        raise RuntimeError(f"{_ENV}=cuda but torch.cuda.is_available() is False")
+    if name == "mps" and not torch.backends.mps.is_available():
+        raise RuntimeError(f"{_ENV}=mps but torch.backends.mps.is_available() is False")
+    if name not in ("cuda", "mps", "cpu"):
+        raise RuntimeError(f"{_ENV}={name!r} is not one of cuda, mps, cpu")
+
+    return torch.device(name)
+
+
+def autocast_device_type() -> str:
+    """Device type for @torch.autocast decorators, evaluated at import.
+
+    These decorators were written `device_type='cuda'`. Off CUDA torch does not
+    raise on that - it warns and DISABLES the autocast - and that silent disable is
+    what made this model unrunnable on Metal. TokenRig puts its transformer in
+    bfloat16 explicitly while the encoder stays float32, and it is autocast that
+    reconciles the two. With autocast off, a bf16 tensor reaches an fp32 weight and
+    the driver aborts the process outright:
+
+        MPSNDArrayMatrixMultiplication.mm:5028: failed assertion `Destination
+        NDArray and Accumulator NDArray cannot have different datatype'
+
+    Verified on this machine: `torch.autocast('mps', dtype=torch.bfloat16)` works,
+    and the same matmul without it raises `expected mat1 and mat2 to have the same
+    dtype`. So the decorators follow the declared device.
+
+    Importing a model module therefore requires SKINTOKENS_DEVICE to be set. That
+    is deliberate - the alternative is the silent disable above.
+    """
+    return resolve_device().type
